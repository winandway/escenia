# La Estación corre en la Mac. Copia este archivo como .env y rellena.
PANEL_URL=https://escenia.sitios.dev
ESTACION_SECRETO=              # el mismo valor que ESTACION_SECRETO en el panel
ELEVENLABS_API_KEY=            # si falta, usa la voz de prueba del sistema (macOS `say`)
ELEVENLABS_VOICE_ID=           # id de la voz clonada de Richard (la usan los guiones con voz «richard»)
ELEVENLABS_VOICE_ID_FEMENINA=  # id de la voz femenina (guiones con voz «femenina»); si falta, esos trabajos fallan con aviso
ELEVENLABS_MODELO=eleven_multilingual_v2
PEXELS_API_KEY=                # si falta, usa fondos de color en vez de clips
CARPETA_SALIDA=./out           # dónde quedan los MP4
FAL_KEY=                       # fal.ai (prepago) para imágenes generadas; sin ella, esas escenas van con clip
GOOGLE_CSE_KEY=                # Google Custom Search (fotos reales del artista desde internet); sin ella, solo Wikimedia
GOOGLE_CSE_CX=                 # id del motor de búsqueda programable (con búsqueda de imágenes activada)
