# Variables del PANEL. En producción van en YaDominios Cloud → tarjeta del sitio → Variables de entorno.
# En local van en .dev.vars (para `wrangler dev`) o .env.local (para `next dev`).
PANEL_CLAVE_HUELLA=            # sale de: npm run clave
ESTACION_SECRETO=              # 32+ letras al azar; el mismo va en estacion/.env
ANTHROPIC_API_KEY=             # guiones
TURNSTILE_SITE_KEY=            # opcional: escudo anti-robots en /entrar
TURNSTILE_SECRET_KEY=          # opcional
